# ── Database (required) ──
# Pooled connection for the app (serverless-safe).
DATABASE_URL="postgresql://user:password@host:5432/renovam?schema=public"
# Direct connection for migrations (Prisma migrate).
DIRECT_URL="postgresql://user:password@host:5432/renovam?schema=public"

# ── Telegram Bot API (required for lead notifications) ──
# Create a bot via @BotFather, add it to your sales group, then read the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Rate limiting (optional; defaults shown) ──
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=3600000

# ── Analytics / site (optional; used by later phases) ──
NEXT_PUBLIC_SITE_URL=https://renovam.am
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ── Anti-spam captcha (optional; Turnstile hook reserved for later) ──
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
